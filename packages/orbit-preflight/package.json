{
  "name": "orbit-preflight",
  "version": "0.1.0",
  "description": "Startup checks that turn silent chain misconfigurations into a refusal to boot. Zero dependencies.",
  "homepage": "https://www.zorpha.xyz/writing/silent-failures",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "ethereum",
    "arbitrum",
    "orbit",
    "rollup",
    "rpc",
    "indexer",
    "preflight",
    "chain-id"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
