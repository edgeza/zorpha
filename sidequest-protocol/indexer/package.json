{
  "name": "@zorpha/indexer",
  "version": "1.0.0",
  "description": "Zorpha receipts indexer — long-running service for Robinhood Chain",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "start:keeper": "node dist/oracle-keeper.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "orbit-preflight": "file:../../packages/orbit-preflight",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
