# ─── Zorpha indexer — Robinhood Chain MAINNET (4663) ────────────────────────
#
# Paste into the Railway service whose root directory is
# `sidequest-protocol/indexer`, start command `npm start`.
#
# EVERY VALUE HERE DIFFERS FROM TESTNET. The chain ids differ by one digit
# (4663 / 46630) and it is tempting to change only that one. The config that
# prompted this file carried CHAIN_ID=4663 beside a testnet RPC, a testnet
# explorer, three testnet vault addresses and a testnet block height -- five
# values, one flipped. `assertChainPreflight()` now refuses to start on any of
# those combinations, but it is cheaper to copy the whole block.

RPC_URL=https://rpc.mainnet.chain.robinhood.com/rpc
CHAIN_ID=4663
EXPLORER_URL=https://robinhoodchain.blockscout.com

# NOT the testnet fallback. `robinhood-sepolia-rpc.publicnode.com` answers
# 46630, and viem fails over on transport errors rather than on chain identity,
# so listing it here means a mainnet indexer quietly reads TESTNET whenever the
# primary hiccups. Verified with eth_chainId against both hosts on 2026-09-05:
#
#   robinhood-sepolia-rpc.publicnode.com  -> 46630   NEVER use here
#   robinhood-rpc.publicnode.com          ->  4663   safe
#
# A second mainnet endpoint does exist, so this is set rather than left blank:
# a single RPC is a single point of failure for the whole receipt feed.
RPC_URL_FALLBACK=https://robinhood-rpc.publicnode.com

# Supabase. One project serves both chains; rows are separated by chain_id
# (migrations 011 and 012), not by project. The SERVICE ROLE key bypasses RLS
# and must never reach the browser or a NEXT_PUBLIC_ variable.
SUPABASE_URL=https://inqygeuwiijeskdbmggy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The block zsUSDG was launched, confirmed by eth_getLogs: the vault's only log
# on 4663 is at 55,038,004. Not 112,522,500 -- that is a TESTNET height, 57M
# blocks past mainnet's head, and it makes every scan return empty while every
# cycle reports success.
START_BLOCK=55038004

# Only read under DRY_RUN=1. In production the vault list is the `vaults`
# TABLE, filtered to CHAIN_ID. Kept here because assertChainPreflight() checks
# each address has code on this chain, which is a cheap way to catch a
# copy-paste from the testnet config.
#   0x3829bC787d4eB15Ec855A6cA33e1492a9103d130  Zorpha Steakhouse USDG (zsUSDG)
VAULT_ADDRESSES=0x3829bC787d4eB15Ec855A6cA33e1492a9103d130

# Blank: no ReputationRegistry is deployed on 4663. The minimal deploy path
# shipped ZOR, the Safe, Vesting, the Timelock, the Treasury, Buyback,
# Insurance, the MerkleDistributor, VaultFactory and VaultLauncher -- and none
# of the reputation or oracle stack. Setting the testnet address here would
# scan an address with no code forever.
REPUTATION_REGISTRY_ADDRESS=

# Tuning. Block time is ~0.17s on both deployments.
#
# CONFIRMATIONS=3 buys 0.5 SECONDS of reorg protection, which is not
# protection. It was carried over from a default written for a chain with
# 12-second blocks. 120 blocks is ~20 seconds, and on mainnet a reorg that is
# written and then contradicted is a public receipt that has to be retracted.
BLOCK_CHUNK_SIZE=50000
CONFIRMATIONS=120
POLL_INTERVAL_MS=12000
MAX_CONSECUTIVE_FAILURES=10
PORT=8080

# ─── Before starting this service ───────────────────────────────────────────
#
# 1. Apply zorpha-web/migrations/012-cursor-and-vault-chain-scope.sql. Until it
#    runs, `vaults` and `indexer_cursor` have no chain_id and every write path
#    here raises 42P10 or PGRST204.
# 2. Expect ZERO receipts at first. zsUSDG has exactly one log on 4663 -- its
#    deployment -- and has never rebalanced. An empty feed is the correct
#    answer, not a fault. `/healthz` reports cyclesCompleted rising with
#    receiptsIndexed at 0.
