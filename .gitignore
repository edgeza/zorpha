# Dependencies
node_modules/
.pnpm-store/

# Secrets — never commit
.env
.env.local
.env.*.local
# deploy-and-verify.sh copies .env.local here before rewriting it, so this file
# exists after every deploy and holds the same Supabase and WalletConnect keys.
.env.local.bak
*.pem
*.key

# Next.js
.next/
out/
.vercel/

# Foundry
sidequest-protocol/contracts/out/
sidequest-protocol/contracts/cache/
sidequest-protocol/contracts/broadcast/
!sidequest-protocol/contracts/broadcast/**/run-latest.json

# Indexer build
sidequest-protocol/indexer/dist/

# Airdrop proofs are generated from a snapshot. The per-recipient files are not
# worth committing -- thousands of tiny files -- but proofs.json and the
# manifest are, because the claim API reads proofs off disk at runtime and a
# deployment only ever has what git tracked. Without proofs.json every claim
# 404s in production while working fine locally.
zorpha-web/data/airdrop/*.json
!zorpha-web/data/airdrop/manifest.json
!zorpha-web/data/airdrop/proofs.json

# Tooling / OS
.DS_Store
Thumbs.db
*.log
.turbo/
tsconfig.tsbuildinfo
*.tsbuildinfo

# Agent skills are installed to .agents/skills (canonical). On Windows the
# installer copies rather than symlinks, so .claude/skills is a duplicate.
.claude/skills/
