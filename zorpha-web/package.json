{
  "name": "zorpha-web",
  "version": "1.0.0",
  "description": "Zorpha ($ZOR), marketing site and protocol portal",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:verify": "node scripts/dev-verify.mjs",
    "prebuild": "node scripts/check-env.mjs && node scripts/check-tokenomics.mjs && node scripts/check-contrast.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:tokenomics": "node scripts/check-tokenomics.mjs",
    "logo:crop": "node script/crop-logo.js",
    "logo:favicon": "node script/crop-logo.js app/favicon.png app/icon.png --square --fill=92",
    "check:env": "node scripts/check-env.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:routes": "node scripts/crawl-routes.mjs",
    "test": "node --import tsx --test lib/**/*.test.ts"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@lifi/widget": "4.5.0",
    "@lifi/widget-provider-ethereum": "4.1.3",
    "@metamask/connect-evm": "^2.1.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.90.0",
    "@wagmi/connectors": "8.0.20",
    "@wagmi/core": "3.5.5",
    "@walletconnect/ethereum-provider": "^2.24.0",
    "motion": "^13.2.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1",
    "viem": "^2.53.1",
    "wagmi": "3.6.21"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.10.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
