# ─── Zorpha web ─────────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Every NEXT_PUBLIC_* var here is read as a
# LITERAL process.env.NEXT_PUBLIC_X reference in lib/contracts.ts. Next.js only
# inlines statically analysable lookups, so a dynamic key would silently
# resolve to undefined in the browser bundle (audit finding M-01). If you add a
# variable, add a literal line for it there too.

# Site
NEXT_PUBLIC_SITE_URL=https://zorpha.xyz

# Chain — 46630 = Robinhood Chain testnet, 4663 = mainnet
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://testnet.rpc.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://testnet-explorer.robinhood.com

# Indexer (optional). With these unset the site still builds and renders;
# receipt and manager views show an explicit empty state instead of failing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Token layer (from DeployZorphaToken.s.sol output) ──────────────────────
# Any address left blank is reported by name in the portal's "not configured"
# banner rather than silently rendering as a zero balance.
NEXT_PUBLIC_ZOR_ADDRESS=
NEXT_PUBLIC_VESTING_ADDRESS=
NEXT_PUBLIC_MERKLE_DISTRIBUTOR_ADDRESS=
NEXT_PUBLIC_BUYBACK_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_INSURANCE_ADDRESS=
NEXT_PUBLIC_TIMELOCK_ADDRESS=

# ─── Vault layer (from DeployVaultsV1.s.sol output) ─────────────────────────
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=
NEXT_PUBLIC_STRATEGY_EXECUTOR_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=

# ─── Feature flags ─────────────────────────────────────────────────────────
# Vault deposits default to ENABLED. Audit finding V-01 is closed and the
# contract suite is green (93/93). Set this to the literal string "false" to
# kill the deposit surface across all vaults without a redeploy — keep that
# lever in mind during an incident.
NEXT_PUBLIC_ENABLE_VAULT_DEPOSITS=true
