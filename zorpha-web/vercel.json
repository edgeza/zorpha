{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/airdrop/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/portal",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "/protocol",
      "permanent": false
    }
  ]
}
